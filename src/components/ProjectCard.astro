---
import { Picture } from 'astro:assets';
import { projectHref, type Project } from '../lib/util';
interface Props { project: Project; size?: 'large' | 'small'; eager?: boolean }
const { project: p, size = 'small', eager = false } = Astro.props;
const sizes = size === 'large' ? '(min-width: 900px) 560px, 100vw' : '(min-width: 1000px) 360px, (min-width: 640px) 45vw, 100vw';
const meta = [p.data.course, p.data.date].filter(Boolean).join(' · ');
---
<article class={`card ${size}`} data-categories={p.data.categories.join('|')}>
  <a href={projectHref(p)} class="link">
    <div class="thumb">
      <Picture
        src={p.data.hero}
        alt=""
        widths={size === 'large' ? [480, 720, 1120] : [360, 560, 760]}
        sizes={sizes}
        formats={['avif', 'webp']} fallbackFormat="webp"
        loading={eager ? 'eager' : 'lazy'}
        layout="none"
      />
    </div>
    <div class="body">
      <h3>{p.data.title}</h3>
      {p.data.summary && <p class="summary">{p.data.summary}</p>}
      {meta && <p class="meta">{meta}</p>}
    </div>
  </a>
</article>
<style>
  .card { min-width: 0; }
  .link { display: block; color: inherit; text-decoration: none; }
  .thumb { aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--line); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .link:hover .thumb :global(img) { transform: scale(1.025); }
  .link:hover .thumb { border-color: var(--sage); }
  @media (prefers-reduced-motion: reduce) { .link:hover .thumb :global(img) { transform: none; } }
  .body { padding-top: 14px; }
  h3 { font-size: 1.05rem; font-weight: 600; transition: color .15s; }
  .large h3 { font-size: 1.2rem; }
  .link:hover h3 { color: var(--accent); }
  .summary { margin-top: 6px; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .meta { margin-top: 8px; }
</style>
