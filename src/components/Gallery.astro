---
import { Picture, getImage } from 'astro:assets';
import type { Project } from '../lib/util';
interface Props { items: Project['data']['gallery']; title: string }
const { items, title } = Astro.props;
// keep original order, grouped by `group`
const groups: { name: string; items: (typeof items[number] & { full: string; i: number })[] }[] = [];
let i = 0;
for (const it of items) {
  const full = (await getImage({ src: it.src, width: Math.min(1800, it.src.width), format: 'webp', quality: 80 })).src;
  let g = groups.find((x) => x.name === it.group);
  if (!g) groups.push((g = { name: it.group, items: [] }));
  g.items.push({ ...it, full, i: i++ });
}
---
{items.length > 0 && (
  <div class="gallery" data-gallery>
    {groups.map((g) => (
      <div class="group">
        {g.name && <h3>{g.name}</h3>}
        <ul>
          {g.items.map((it) => (
            <li>
              <button type="button" data-full={it.full} data-caption={it.caption} data-i={it.i}
                aria-label={`Enlarge image ${it.i + 1}${it.caption ? `: ${it.caption}` : ''}`}>
                <Picture src={it.src} alt={it.caption || `${title}, image ${it.i + 1}`} widths={[320, 520, 760]}
                  sizes="(min-width: 1000px) 280px, (min-width: 640px) 30vw, 50vw" formats={['webp']} fallbackFormat="webp" loading="lazy" layout="none" />
              </button>
              {it.caption && <p class="cap">{it.caption}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))}
    <dialog class="lightbox" aria-label="Image viewer">
      <img alt="" />
      <p class="lb-cap"></p>
      <button type="button" class="lb-btn lb-prev" aria-label="Previous image">‹</button>
      <button type="button" class="lb-btn lb-next" aria-label="Next image">›</button>
      <button type="button" class="lb-btn lb-close" aria-label="Close">×</button>
    </dialog>
  </div>
)}
<style>
  .group + .group { margin-top: 32px; }
  h3 { font-size: 1rem; margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr)); }
  li button { display: block; width: 100%; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface-2); cursor: zoom-in; aspect-ratio: 4 / 3; }
  li button :global(img) { width: 100%; height: 100%; object-fit: cover; transition: opacity .15s; }
  li button:hover :global(img) { opacity: .9; }
  .cap { font-size: var(--step--1); color: var(--muted); margin-top: 6px; line-height: 1.4; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgb(15 15 15 / .92); }
  .lightbox[open] { display: grid; place-items: center; grid-template-rows: 1fr auto; }
  .lightbox img { max-width: min(92vw, 1600px); max-height: calc(100vh - 110px); width: auto; height: auto; object-fit: contain; align-self: end; }
  .lb-cap { color: #ddd; font-size: var(--step--1); padding: 12px 16px 20px; min-height: 1.5em; text-align: center; }
  .lb-btn { position: fixed; background: rgb(0 0 0 / .4); color: #fff; border: 0; width: 44px; height: 44px; border-radius: 50%; font-size: 28px; line-height: 1; cursor: pointer; }
  .lb-btn:hover { background: rgb(0 0 0 / .7); }
  .lb-prev { left: 12px; top: 50%; translate: 0 -50%; }
  .lb-next { right: 12px; top: 50%; translate: 0 -50%; }
  .lb-close { right: 12px; top: 12px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('button[data-full]')];
    const dlg = root.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('.lb-cap')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + btns.length) % btns.length;
      const b = btns[cur];
      img.src = b.dataset.full!;
      img.alt = b.querySelector('img')?.alt || '';
      cap.textContent = `${b.dataset.caption ? b.dataset.caption + ' · ' : ''}${cur + 1} / ${btns.length}`;
    };
    btns.forEach((b, i) => b.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
    if (btns.length < 2) dlg.querySelectorAll<HTMLElement>('.lb-prev, .lb-next').forEach((x) => (x.hidden = true));
  });
</script>
